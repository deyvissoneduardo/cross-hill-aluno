# Firebase Admin SDK (server-only)
# Obtenha estes valores na conta de servico do Firebase.
# Nao use prefixo NEXT_PUBLIC_ para credenciais Firebase neste projeto.
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto-firebase.iam.gserviceaccount.com

# Use a chave privada PEM com quebras de linha escapadas como \n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# Opcional: porta usada pelo Playwright/dev server. Padrao: 3000.
# PORT=3000
